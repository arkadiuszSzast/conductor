{
  "name": "@conductor/web",
  "version": "0.1.0",
  "private": true,
  "description": "Conductor web UI — Control Room (board + feature view).",
  "type": "module",
  "main": "src/main.tsx",
  "module": "src/main.tsx",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:vite": "vite build",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals",
    "test:mounted": "NODE_ENV=development bun test test/*-mounted.test.tsx"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "wouter": "^3.10.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.11.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0"
  }
}
